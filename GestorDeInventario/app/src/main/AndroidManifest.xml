<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Desde Android 13 las notificaciones se PIDEN, no se dan. MainActivity
      lanza la peticion al abrir; en versiones anteriores se concede sola.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GestorDeInventarioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestorDeInventario">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GestorDeInventario"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Para que la pantalla pueda COMPARTIR el .csv exportado con un Intent.
          La authority se arma con el applicationId para que nunca choque con
          la de otra app instalada. grantUriPermissions da acceso temporal.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>

        <!--
          APAGA el arranque automatico de WorkManager.

          Por omision WorkManager se inicializa solo, antes que Hilt, con una
          fabrica de Workers que no sabe inyectar nada. Quitandolo de aqui,
          WorkManager se inicializa cuando alguien lo pide y usa la
          configuracion de GestorDeInventarioApp, que si trae la fabrica de
          Hilt. Sin estas lineas, RevisorDeCaducidades falla al construirse.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>